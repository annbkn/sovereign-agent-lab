#!/usr/bin/expect -f

set timeout 120

# Start the rasa shell command
spawn bash -c "export PATH=\"\$HOME/.local/bin:\$PATH\" && make ex3-chat"

# Expect the bot to be ready
expect "Your input ->"

# Happy path
send "calling to confirm a booking\r"
expect "Your input ->"

send "160 guests\r"
expect "Your input ->"

send "about 50 vegan\r"
expect "Your input ->"

send "£200 deposit\r"
expect "Your input ->"

# Deposit too high
send "calling to confirm a booking\r"
expect "Your input ->"

send "160 guests\r"
expect "Your input ->"

send "about 50 vegan\r"
expect "Your input ->"

send "£350 deposit\r"
expect "Your input ->"

# Out of scope
send "calling to confirm a booking\r"
expect "Your input ->"

send "160 guests\r"
expect "Your input ->"

send "what time does the train leave?\r"
expect "Your input ->"

send "/stop\r"

expect eof
